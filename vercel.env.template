# Copy each line to Vercel → Project → Settings → Environment Variables
# Apply to: Production, Preview, Development
# After adding ALL variables → Deployments → Redeploy

# ========== FIREBASE (client — must start with VITE_) ==========
# Copy values from your local client/.env file

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ========== DATABASE + API (serverless — NO VITE_ prefix) ==========
# Copy values from your local server/.env file

MONGODB_URI=
JWT_SECRET=
NODE_ENV=production

# ========== DO NOT ADD on Vercel ==========
# VITE_API_URL  (leave unset — API runs on same Vercel domain at /api)

# ========== Firebase Console (one-time) ==========
# Authentication → Settings → Authorized domains → add:
#   pet-adoption-client-alpha.vercel.app
#   (your exact Vercel URL)

# ========== MongoDB Atlas (one-time) ==========
# Network Access → allow 0.0.0.0/0 (already done if local works)
